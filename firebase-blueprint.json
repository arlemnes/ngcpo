{
  "entities": {
    "Contract": {
      "title": "Contract",
      "description": "Public contract entity with technical, financial and milestone execution details",
      "type": "object",
      "properties": {
        "code": { "type": "string", "description": "Unique contract reference or code" },
        "title": { "type": "string", "description": "Title or object of the contract" },
        "vendor": { "type": "string", "description": "Contractor or vendor name" },
        "phase": { "type": "string", "description": "Current phase or status of the contract" },
        "globalValue": { "type": "number", "description": "Global contractual value in EUR" }
      },
      "required": ["code", "title"]
    },
    "User": {
      "title": "User",
      "description": "Application user account and role details",
      "type": "object",
      "properties": {
        "username": { "type": "string", "description": "User display name" },
        "email": { "type": "string", "description": "User email address" },
        "role": { "type": "string", "description": "User role: admin or user" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/contracts/{contractId}": {
      "schema": "Contract",
      "description": "Collection storing all contract records"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection storing user profiles"
    }
  }
}
